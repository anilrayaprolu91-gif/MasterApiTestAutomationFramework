{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restful Booker Auth Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+$"
    }
  }
}

